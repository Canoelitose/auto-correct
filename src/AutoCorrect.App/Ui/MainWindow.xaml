<Window x:Class="AutoCorrect.App.Ui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoCorrect"
        Width="760"
        Height="620"
        MinWidth="560"
        MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#FFFDFDFD"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="TextMuted" Color="#FF71717A" />
        <SolidColorBrush x:Key="PanelBorder" Color="#FFE4E4E7" />
        <SolidColorBrush x:Key="ErrorForeground" Color="#FFB91C1C" />
        <SolidColorBrush x:Key="ErrorBackground" Color="#FFFEF2F2" />
        <SolidColorBrush x:Key="Accent" Color="#FF2563EB" />

        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,0,5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
            <Setter Property="FontSize" Value="11" />
        </Style>

        <Style x:Key="ModeButton" TargetType="Button">
            <Setter Property="Padding" Value="14,7" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinWidth" Value="110" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Shell"
                                Background="#FFF4F4F5"
                                BorderBrush="{StaticResource PanelBorder}"
                                BorderThickness="1"
                                CornerRadius="5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Shell" Property="Background" Value="#FFE4E4E7" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Shell" Property="Opacity" Value="0.45" />
                            </Trigger>
                            <Trigger Property="Tag" Value="active">
                                <Setter TargetName="Shell" Property="Background" Value="{StaticResource Accent}" />
                                <Setter TargetName="Shell" Property="BorderBrush" Value="{StaticResource Accent}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock x:Name="TitleText" FontSize="18" FontWeight="SemiBold" />
                <TextBlock x:Name="HotkeyHintText"
                           Style="{StaticResource SectionLabel}"
                           Margin="0,3,0,0"
                           TextWrapping="Wrap" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Top">
                <Button x:Name="SettingsButton" Padding="12,6" Margin="0,0,8,0" />
                <Button x:Name="AboutButton" Padding="12,6" />
            </StackPanel>
        </Grid>

        <!-- Input -->
        <DockPanel Grid.Row="1">
            <TextBlock x:Name="InputLabel" DockPanel.Dock="Top" Style="{StaticResource SectionLabel}" />
            <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="5">
                <TextBox x:Name="InputBox"
                         BorderThickness="0"
                         Padding="10,8"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         SpellCheck.IsEnabled="True" />
            </Border>
        </DockPanel>

        <!-- Modes -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,12">
            <Button x:Name="ModeCorrectButton" Style="{StaticResource ModeButton}" />
            <Button x:Name="ModeRephraseButton" Style="{StaticResource ModeButton}" />
            <Button x:Name="ModeFormalButton" Style="{StaticResource ModeButton}" />
            <Button x:Name="ModeShortenButton" Style="{StaticResource ModeButton}" />
        </StackPanel>

        <!-- Result -->
        <DockPanel Grid.Row="3">
            <TextBlock x:Name="ResultLabel" DockPanel.Dock="Top" Style="{StaticResource SectionLabel}" />
            <Border BorderBrush="{StaticResource PanelBorder}" BorderThickness="1" CornerRadius="5">
                <Grid>
                    <TextBox x:Name="ResultBox"
                             BorderThickness="0"
                             Padding="10,8"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                    <ProgressBar x:Name="BusyBar"
                                 Height="3"
                                 VerticalAlignment="Top"
                                 IsIndeterminate="False"
                                 Visibility="Collapsed"
                                 BorderThickness="0" />
                </Grid>
            </Border>
        </DockPanel>

        <!-- Error -->
        <Border x:Name="ErrorPanel"
                Grid.Row="4"
                Margin="0,10,0,0"
                Padding="10,8"
                CornerRadius="5"
                Visibility="Collapsed"
                Background="{StaticResource ErrorBackground}"
                BorderBrush="#FFFECACA"
                BorderThickness="1">
            <TextBlock x:Name="ErrorText"
                       TextWrapping="Wrap"
                       Foreground="{StaticResource ErrorForeground}" />
        </Border>

        <!-- Footer -->
        <Grid Grid.Row="5" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"
                       Foreground="{StaticResource TextMuted}"
                       FontSize="11" />

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button x:Name="UseResultButton" Padding="12,6" Margin="0,0,8,0" />
                <Button x:Name="CopyButton" Padding="12,6" Margin="0,0,8,0" />
                <Button x:Name="ClearButton" Padding="12,6" />
            </StackPanel>
        </Grid>
    </Grid>
</Window>
