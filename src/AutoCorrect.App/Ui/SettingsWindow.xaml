<Window x:Class="AutoCorrect.App.Ui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoCorrect – Einstellungen"
        Width="520"
        Height="470"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="True"
        Background="#FFFDFDFD"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="TextMuted" Color="#FF71717A" />
        <SolidColorBrush x:Key="ErrorForeground" Color="#FFB91C1C" />

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,12,0,4" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>

        <Style x:Key="Hint" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,3,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Foreground" Value="{StaticResource TextMuted}" />
        </Style>
    </Window.Resources>

    <Grid Margin="18">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Hotkey Korrigieren" Style="{StaticResource FieldLabel}" Margin="0,0,0,4" />
                <TextBox x:Name="PrimaryHotkeyBox" IsReadOnly="True" Padding="6,5" />
                <TextBlock Text="Feld anklicken und die gewünschte Tastenkombination drücken."
                           Style="{StaticResource Hint}" />

                <TextBlock Text="Hotkey Umformulieren" Style="{StaticResource FieldLabel}" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="RephraseHotkeyBox" Grid.Column="0" IsReadOnly="True" Padding="6,5" />
                    <Button x:Name="ClearRephraseButton"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            Padding="10,4"
                            Content="Löschen" />
                </Grid>

                <TextBlock Text="LanguageTool-Adresse" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="EndpointBox" Padding="6,5" />
                <TextBlock Text="Standard: http://localhost:8081/v2/check" Style="{StaticResource Hint}" />

                <TextBlock Text="Sprache" Style="{StaticResource FieldLabel}" />
                <TextBox x:Name="LanguageBox" Padding="6,5" />
                <TextBlock Text="Standard: de-CH (Schweizer Rechtschreibung, ss statt ß)"
                           Style="{StaticResource Hint}" />

                <CheckBox x:Name="AutoStartCheck"
                          Margin="0,18,0,0"
                          Content="Mit Windows starten" />

                <CheckBox x:Name="UiAutomationCheck"
                          Margin="0,10,0,0"
                          Content="Text zuerst über UI Automation lesen (empfohlen)" />

                <TextBlock Text="Ohne UI Automation wird immer über die Zwischenablage gelesen."
                           Style="{StaticResource Hint}" />

                <Button x:Name="TestButton"
                        Margin="0,18,0,0"
                        Padding="10,5"
                        HorizontalAlignment="Left"
                        Content="Verbindung testen" />

                <TextBlock x:Name="TestResultText" Style="{StaticResource Hint}" />

                <TextBlock x:Name="ErrorText"
                           Margin="0,14,0,0"
                           TextWrapping="Wrap"
                           Visibility="Collapsed"
                           Foreground="{StaticResource ErrorForeground}" />
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Margin="0,16,0,0">
            <Button x:Name="CancelButton" Padding="16,6" Margin="0,0,8,0" Content="Abbrechen" IsCancel="True" />
            <Button x:Name="SaveButton" Padding="16,6" Content="Speichern" IsDefault="True" />
        </StackPanel>
    </Grid>
</Window>
