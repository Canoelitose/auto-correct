<Window x:Class="AutoCorrect.App.Ui.PopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoCorrect"
        Width="580"
        Height="410"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        FontFamily="Segoe UI"
        FontSize="13">

    <Window.Resources>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFDFDFD" />
        <SolidColorBrush x:Key="CardBorder" Color="#FFD4D4D8" />
        <SolidColorBrush x:Key="SurfaceMuted" Color="#FFF4F4F5" />
        <SolidColorBrush x:Key="TextPrimary" Color="#FF18181B" />
        <SolidColorBrush x:Key="TextMuted" Color="#FF71717A" />
        <SolidColorBrush x:Key="AccentBackground" Color="#FF1F6FEB" />
        <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="ChipBackground" Color="#FFF4F4F5" />
        <SolidColorBrush x:Key="ChipBorder" Color="#FFD4D4D8" />
        <SolidColorBrush x:Key="ErrorForeground" Color="#FFB91C1C" />
        <SolidColorBrush x:Key="ErrorBackground" Color="#FFFEF2F2" />

        <Style x:Key="ModeButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="11,5" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="{StaticResource ChipBackground}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimary}" />
            <Setter Property="BorderBrush" Value="{StaticResource ChipBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                CornerRadius="6"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border Margin="14"
            CornerRadius="10"
            Background="{StaticResource CardBackground}"
            BorderBrush="{StaticResource CardBorder}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="18" ShadowDepth="3" Direction="270" Opacity="0.22" Color="#FF000000" />
        </Border.Effect>

        <Grid Margin="16,12,16,12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Header -->
            <Grid Grid.Row="0" Margin="0,0,0,8">
                <TextBlock Text="AutoCorrect"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimary}" />
                <TextBlock x:Name="EngineLabel"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           Foreground="{StaticResource TextMuted}" />
            </Grid>

            <ProgressBar x:Name="BusyBar"
                         Grid.Row="1"
                         Height="2"
                         Margin="0,0,0,8"
                         IsIndeterminate="False"
                         Visibility="Collapsed"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{StaticResource AccentBackground}" />

            <!-- Original text, read only and shortened -->
            <Border Grid.Row="2"
                    Margin="0,0,0,10"
                    Padding="10,8"
                    CornerRadius="6"
                    Background="{StaticResource SurfaceMuted}">
                <StackPanel>
                    <TextBlock x:Name="OriginalLabel"
                               FontSize="11"
                               Margin="0,0,0,3"
                               Foreground="{StaticResource TextMuted}" />
                    <TextBlock x:Name="OriginalText"
                               MaxHeight="60"
                               TextWrapping="Wrap"
                               TextTrimming="CharacterEllipsis"
                               Foreground="{StaticResource TextPrimary}" />
                </StackPanel>
            </Border>

            <!-- Result, editable -->
            <Border Grid.Row="3"
                    Padding="1"
                    CornerRadius="6"
                    BorderBrush="{StaticResource CardBorder}"
                    BorderThickness="1">
                <TextBox x:Name="ResultBox"
                         BorderThickness="0"
                         Padding="9,7"
                         Background="Transparent"
                         Foreground="{StaticResource TextPrimary}"
                         AcceptsReturn="True"
                         TextWrapping="Wrap"
                         VerticalScrollBarVisibility="Auto"
                         VerticalContentAlignment="Top" />
            </Border>

            <!-- Error message -->
            <Border x:Name="ErrorPanel"
                    Grid.Row="4"
                    Margin="0,10,0,0"
                    Padding="10,8"
                    CornerRadius="6"
                    Visibility="Collapsed"
                    Background="{StaticResource ErrorBackground}">
                <TextBlock x:Name="ErrorText"
                           TextWrapping="Wrap"
                           FontSize="12"
                           Foreground="{StaticResource ErrorForeground}" />
            </Border>

            <!-- Modes -->
            <StackPanel Grid.Row="5" Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="ModeCorrectButton" Style="{StaticResource ModeButtonStyle}" />
                <Button x:Name="ModeRephraseButton" Style="{StaticResource ModeButtonStyle}" />
                <Button x:Name="ModeFormalButton" Style="{StaticResource ModeButtonStyle}" />
                <Button x:Name="ModeShortenButton" Style="{StaticResource ModeButtonStyle}" />
            </StackPanel>

            <!-- Status and shortcuts -->
            <Grid Grid.Row="6" Margin="0,10,0,0">
                <TextBlock x:Name="StatusText"
                           FontSize="11"
                           TextTrimming="CharacterEllipsis"
                           Foreground="{StaticResource TextMuted}" />
                <TextBlock x:Name="ShortcutHint"
                           HorizontalAlignment="Right"
                           FontSize="11"
                           Foreground="{StaticResource TextMuted}" />
            </Grid>
        </Grid>
    </Border>
</Window>
