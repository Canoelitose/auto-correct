<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- A console application on purpose. As a WinExe the process is detached from the
         console, so a shell neither waits for it nor sees its exit code, and a failing test
         run would look like a pass. WPF windows work fine from a console host as long as the
         main thread is STA. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>12.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>AutoCorrect.App.Tests</RootNamespace>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <StartupObject>AutoCorrect.App.Tests.Program</StartupObject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\AutoCorrect.App\AutoCorrect.App.csproj" />
    <ProjectReference Include="..\..\src\AutoCorrect.Core\AutoCorrect.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- The tiny runner is shared with the core test project instead of being duplicated. -->
    <Compile Include="..\AutoCorrect.Core.Tests\TestRunner.cs" Link="TestRunner.cs" />
  </ItemGroup>

</Project>
